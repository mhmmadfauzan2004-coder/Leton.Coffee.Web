# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: (Frontend) Base URL for backend Express server (e.g., https://leton-api.onrender.com).
# Leave empty for local development or same-domain deployment.
VITE_API_URL=

# CORS_ORIGIN: (Backend) Allowed origin(s) for CORS, separated by comma.
# Example: https://letoncoffee.pages.dev,https://letoncoffee.com
CORS_ORIGIN=

# VITE_SUPABASE_URL: Supabase Project URL
VITE_SUPABASE_URL="https://galwyavdonfzuibrmswt.supabase.co"

# VITE_SUPABASE_ANON_KEY: Supabase Anonymous Public API Key
VITE_SUPABASE_ANON_KEY="GANTI_DENGAN_ANON_KEY_YANG_SUDAH_DIKOPY"

# BACKGROUND WEB PUSH VAPID KEYS
# These are automatically handled and persisted via /data/vapid_keys.json and local /.env.
# # VAPID_PUBLIC_KEY=
# # VAPID_PRIVATE_KEY=

# FIREBASE CLOUD MESSAGING (FCM) CONFIGURATION
# Frontend Firebase credentials
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# FCM VAPID Key used on frontend to request messaging permission
VITE_FIREBASE_VAPID_KEY=""

# Backend Firebase Service Account (JSON string representation)
# E.g., {"type": "service_account", "project_id": "...", ...}
FIREBASE_SERVICE_ACCOUNT=""

